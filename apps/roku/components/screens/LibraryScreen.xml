<?xml version="1.0" encoding="utf-8" ?>
<!-- Poster grid for Movies, Shows or one library, with sort and filter. -->
<component name="LibraryScreen" extends="Group">
  <interface>
    <field id="config" type="assocarray" onChange="onConfig" />
    <field id="navigate" type="assocarray" alwaysNotify="true" />
    <field id="toast" type="string" alwaysNotify="true" />
    <field id="sessionExpired" type="boolean" alwaysNotify="true" />
    <field id="focusIn" type="boolean" alwaysNotify="true" onChange="restoreFocus" />
    <field id="resumed" type="boolean" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/lib/Utils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Theme.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/RowsSupport.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/LibraryScreen.brs" />
  <children>
    <Label id="title" translation="[96,150]" color="0xF5F7F5FF" />
    <Label id="count" translation="[96,222]" color="0xBBC5BDFF" />
    <ButtonBar id="filters" translation="[96,270]" />
    <MarkupGrid id="grid" translation="[84,368]" itemComponentName="MediaCard" numColumns="7" numRows="2"
      itemSize="[224,421]" itemSpacing="[24,18]" drawFocusFeedback="false" vertFocusAnimationStyle="fixedFocusWrap" />
    <Label id="status" translation="[0,600]" width="1920" horizAlign="center" color="0xBBC5BDFF" />
  </children>
</component>
