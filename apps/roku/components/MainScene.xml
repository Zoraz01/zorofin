<?xml version="1.0" encoding="utf-8" ?>
<!-- App shell: session, tab bar, screen stack, deep links and dialogs. -->
<component name="MainScene" extends="Scene">
  <interface>
    <field id="launchArgs" type="assocarray" onChange="onLaunchArgs" />
    <field id="inputArgs" type="assocarray" onChange="onInputArgs" />
    <field id="exitApp" type="boolean" />
    <field id="unloadImages" type="array" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/lib/Utils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Theme.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Jellyfin.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Store.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/LiveTvStreams.brs" />
  <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
  <children>
    <Rectangle id="background" width="1920" height="1080" color="0x111513FF" />
    <Group id="screens" />
    <TabBar id="tabBar" visible="false" />
    <Group id="toast" visible="false" translation="[660,960]">
      <Poster id="toastBg" uri="pkg:/images/pill.9.png" blendColor="0x262E2AFF" width="600" height="72" />
      <Label id="toastText" width="600" height="72" horizAlign="center" vertAlign="center" color="0xF5F7F5FF" />
    </Group>
    <Group id="dialogLayer" />
    <Group id="busy" visible="false">
      <Rectangle width="1920" height="1080" color="0x11151399" />
      <Label id="busyText" text="Loading…" translation="[0,500]" width="1920" height="80" horizAlign="center" vertAlign="center" color="0xBBC5BDFF" />
    </Group>
    <Timer id="toastTimer" duration="3.5" />
  </children>
</component>
