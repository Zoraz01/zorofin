<?xml version="1.0" encoding="utf-8" ?>
<!--
  Artwork card matching the Apple TV MediaCard: 2:3 poster or 16:9 artwork,
  title and caption below. Works as a RowList or MarkupGrid item component
  (width >= 300 means landscape). Lists give each card 12 px more width
  and height than its artwork: room for the focus ring, which they clip.
-->
<component name="MediaCard" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContent" />
    <field id="width" type="float" onChange="layout" />
    <field id="height" type="float" onChange="layout" />
    <field id="focusPercent" type="float" onChange="onFocus" />
    <field id="rowFocusPercent" type="float" />
    <field id="itemHasFocus" type="boolean" />
    <field id="gridHasFocus" type="boolean" onChange="onFocus" />
    <field id="rowHasFocus" type="boolean" />
    <field id="rowListHasFocus" type="boolean" onChange="onFocus" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/lib/Utils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Theme.brs" />
  <script type="text/brightscript" uri="pkg:/components/widgets/MediaCard.brs" />
  <children>
    <!-- 12 px inset so the focus lift and ring stay inside the list's clip -->
    <Group id="frame" translation="[12,12]">
      <Group id="lift">
        <Rectangle id="placeholder" color="0x1B211EFF" />
        <Label id="fallback" horizAlign="center" vertAlign="center" wrap="true" maxLines="3" color="0xBBC5BDFF" />
        <Poster id="art" loadDisplayMode="scaleToZoom" />
        <!-- Your teams game: shown only once both crests have loaded -->
        <Group id="game" visible="false">
          <Poster id="gameBack" uri="pkg:/images/game_backdrop.png" />
          <Poster id="crestA" loadDisplayMode="scaleToFit" />
          <Label id="versus" text="VS" color="0xFFFFFFB3" horizAlign="center" vertAlign="center" />
          <Poster id="crestB" loadDisplayMode="scaleToFit" />
        </Group>
        <Poster id="corners" uri="pkg:/images/corners.9.png" />
        <Rectangle id="progressFill" color="0x72E79BFF" height="4" visible="false" />
        <Group id="ratingGroup" visible="false">
          <Poster id="ratingPill" uri="pkg:/images/badge.9.png" blendColor="0x000000D1" height="30" />
          <Label id="ratingText" color="0xFFD60AFF" height="30" horizAlign="center" vertAlign="center" />
        </Group>
        <Poster id="badgePill" uri="pkg:/images/badge.9.png" blendColor="0x000000D1" height="26" visible="false" />
        <Label id="badgeText" color="0xFFFFFFFF" height="26" horizAlign="center" vertAlign="center" visible="false" />
        <Rectangle id="liveDot" visible="false" color="0xFF453AFF" width="14" height="14" />
        <Poster id="ring" uri="pkg:/images/card_ring.9.png" opacity="0" />
      </Group>
      <Label id="title" color="0xF5F7F5FF" maxLines="1" />
      <Label id="caption" color="0xBBC5BDFF" maxLines="1" />
      <Label id="gameStatus" color="0x72E79BFF" maxLines="1" visible="false" />
    </Group>
  </children>
</component>
