<?xml version="1.0" encoding="utf-8" ?>
<!--
  A centred choice list (Apple's confirmationDialog / Picker on tvOS).
  options = [{ id, title, subtitle?, checked? }]; result = { id } or {} on Back.
-->
<component name="PickerDialog" extends="Group">
  <interface>
    <field id="title" type="string" onChange="layout" />
    <field id="message" type="string" onChange="layout" />
    <field id="options" type="array" onChange="layout" />
    <field id="result" type="assocarray" alwaysNotify="true" />
    <field id="focusIn" type="boolean" alwaysNotify="true" onChange="takeFocus" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/lib/Utils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Theme.brs" />
  <script type="text/brightscript" uri="pkg:/components/widgets/PickerDialog.brs" />
  <children>
    <Rectangle width="1920" height="1080" color="0x000000A6" />
    <Group id="card">
      <Poster id="bg" uri="pkg:/images/popover.9.png" blendColor="0x262E2AFF" />
      <Label id="heading" translation="[32,28]" width="636" color="0xF5F7F5FF" />
      <Label id="body" translation="[32,74]" width="636" wrap="true" maxLines="9" color="0xBBC5BDFF" />
      <MenuList id="list" width="652" maxHeight="640" />
    </Group>
  </children>
</component>
