<?xml version="1.0" encoding="utf-8" ?>
<!-- Who's watching: rounded-square avatar (photo, else initial) and name. -->
<component name="AccountItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContent" />
    <field id="focusPercent" type="float" onChange="onFocus" />
    <field id="width" type="float" />
    <field id="height" type="float" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/lib/Utils.brs" />
  <script type="text/brightscript" uri="pkg:/source/lib/Theme.brs" />
  <script type="text/brightscript" uri="pkg:/components/widgets/AccountItem.brs" />
  <children>
    <Group id="avatar" scaleRotateCenter="[88,88]" translation="[12,20]" opacity="0.82">
      <Rectangle id="square" width="176" height="176" color="0x24543EFF" />
      <Label id="initial" width="176" height="176" horizAlign="center" vertAlign="center" color="0xBBC5BDFF" />
      <Poster id="photo" width="176" height="176" loadDisplayMode="scaleToZoom" />
      <Poster uri="pkg:/images/corners24.9.png" width="176" height="176" />
      <Poster id="ring" uri="pkg:/images/ring.9.png" width="198" height="198" translation="[-11,-11]" opacity="0" />
    </Group>
    <Label id="name" translation="[0,226]" width="200" horizAlign="center" maxLines="1" color="0xBBC5BDFF" />
  </children>
</component>
